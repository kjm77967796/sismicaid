---
import Base from "../layouts/Base.astro";
import NecesidadesView from "../components/NecesidadesView.svelte";
---

<Base title="Necesidades · SismicAid">
  <main>
    <header>
      <h1>Necesidades</h1>
      <p class="lead">Necesidades verificadas por zona. Si puedes ayudar, copia y comparte.</p>
    </header>
    <NecesidadesView client:load />
  </main>
</Base>

<style>
  main {
    max-width: 880px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-8);
  }
  header {
    margin-bottom: var(--space-5);
  }
  h1 {
    font-size: var(--font-2xl);
    margin: 0 0 var(--space-1);
  }
  .lead {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
