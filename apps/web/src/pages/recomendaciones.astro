---
import Base from "../layouts/Base.astro";
import RecommendationsList from "../components/RecommendationsList.svelte";
---

<Base title="Recomendaciones · Sismicaid">
  <main>
    <header>
      <a href="/" class="back">← Inicio</a>
      <h1>Recomendaciones</h1>
      <p class="lead">Qué hacer antes, durante y después de un sismo o amenaza de tsunami.</p>
    </header>
    <RecommendationsList client:load />
  </main>
</Base>

<style>
  main {
    max-width: 880px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-8);
  }
  header {
    margin-bottom: var(--space-6);
  }
  .back {
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--font-sm);
  }
  h1 {
    font-size: var(--font-2xl);
    margin: var(--space-2) 0 var(--space-1);
  }
  .lead {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
