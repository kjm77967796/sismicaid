---
import "../styles/tokens.css";
import BottomNav from "../components/BottomNav.astro";
import { link } from "../lib/links";

interface Props {
  title?: string;
}
const { title = "Sismicaid" } = Astro.props;
const swUrl = link("/sw.js");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070A0F" />
    <link rel="manifest" href={link("/manifest.webmanifest")} />
    <link rel="icon" href={link("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link("/apple-touch-icon.png")} />
    <title>{title}</title>
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-qPRpR-LEZJ2pHdCQtP3kb.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

  </head>
  <body>
    <div class="page">
      <slot />
    </div>
    <BottomNav />
    <script is:inline define:vars={{ swUrl }}>
      // Registro del Service Worker (PWA). El sw.js usa autoUpdate.
      // swUrl ya respeta el base path (raíz o subpath).
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register(swUrl);
        });
      }
    </script>
  </body>
</html>

<style>
  /* Deja espacio para la nav inferior fija. */
  .page {
    min-height: 100vh;
    padding-bottom: 72px;
  }
</style>
