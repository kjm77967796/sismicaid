---
// Navegación inferior fija (mobile-first). Máx 5 items (design.md §9).
const { pathname } = Astro.url;
const items = [
  { href: "/", label: "Inicio", icon: "⌂" },
  { href: "/sismos", label: "Sismos", icon: "◴" },
  { href: "/ayuda", label: "Ayuda", icon: "✚" },
  { href: "/reportar", label: "Reportar", icon: "✎" },
  { href: "/recomendaciones", label: "Guía", icon: "☑" },
];
const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<nav aria-label="Navegación principal">
  {
    items.map((it) => (
      <a href={it.href} class:list={["item", { active: isActive(it.href) }]} aria-current={isActive(it.href) ? "page" : undefined}>
        <span class="icon" aria-hidden="true">{it.icon}</span>
        <span class="label">{it.label}</span>
      </a>
    ))
  }
</nav>

<style>
  nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-1) 0 calc(var(--space-1) + env(safe-area-inset-bottom, 0));
    z-index: 50;
  }
  .item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: var(--space-2) 0;
    min-height: 44px;
    color: var(--color-text-soft);
    text-decoration: none;
    font-size: var(--font-xs);
  }
  .item.active {
    color: var(--color-primary);
  }
  .icon {
    font-size: 1.25rem;
    line-height: 1;
  }
</style>
