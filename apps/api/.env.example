# Copia a .env y ajusta. NO comitear .env.

# Conexión PostgreSQL (obligatoria).
DATABASE_URL=postgres://user:pass@localhost:5432/sismicaid

# Puerto y host del servidor. Detrás de nginx usa HOST=127.0.0.1.
PORT=3000
HOST=0.0.0.0

# CORS: orígenes permitidos en producción (lista separada por comas).
# Sin definir, refleja cualquier origen (solo recomendable en dev).
# CORS_ORIGIN=https://sismicaid.example

# Ingesta (opcionales).
# USGS_MIN_MAGNITUDE=2.5
# TSUNAMI_FEED_URL=https://www.tsunami.gov/events/xml/PHEBAtom.xml

# Token para acciones de moderación (marcar rescatado). Sin definir, el endpoint
# de resolución responde 401. No comitear el valor real.
# MODERATION_TOKEN=cambia-esto
